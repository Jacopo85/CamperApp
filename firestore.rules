rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(groupId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['email','groupId','updatedAt']);
      allow delete: if false;
    }
    match /invites/{code} {
      // Il codice è casuale e lungo; la lettura è necessaria per consentire l'ingresso.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.groupId is string
        && exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
        && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }
    match /groups/{groupId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if isMember(groupId);
      allow update: if isMember(groupId)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;
      match /members/{userId} {
        allow read: if isMember(groupId);
        allow create: if signedIn() && request.auth.uid == userId
          && (
            (request.resource.data.role == 'owner'
             && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid)
            ||
            (request.resource.data.role == 'member'
             && request.resource.data.inviteCode is string
             && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.groupId == groupId)
          );
        allow update: if signedIn() && request.auth.uid == userId && isMember(groupId)
          && request.resource.data.uid == resource.data.uid;
        allow delete: if signedIn() && request.auth.uid == userId && resource.data.role != 'owner';
      }
      match /{subcollection}/{documentId} {
        allow read, create, update, delete: if isMember(groupId)
          && subcollection in ['shopping','wishlist','settings'];
      }
    }
  }
}