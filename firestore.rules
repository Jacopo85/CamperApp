rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(groupId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }
    function ownEmail() {
      return signedIn() && request.resource.data.email == request.auth.token.email;
    }
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['email','groupId','updatedAt'])
        && request.resource.data.keys().hasAll(['email','groupId','updatedAt'])
        && ownEmail()
        && request.resource.data.groupId is string
        && existsAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)/members/$(request.auth.uid));
      allow delete: if false;
    }
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.matches('^[A-HJ-NP-Z2-9]{16}$')
        && request.resource.data.keys().hasOnly(['groupId','createdBy','createdAt','expiresAt'])
        && request.resource.data.keys().hasAll(['groupId','createdBy','createdAt','expiresAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.groupId is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd')
        && existsAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }
    match /groups/{groupId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if isMember(groupId);
      allow update: if isMember(groupId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
      allow delete: if false;
      match /members/{userId} {
        allow read: if isMember(groupId);
        allow create: if signedIn() && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid
          && ownEmail()
          && request.resource.data.joinedAt == request.time
          && (
            (request.resource.data.role == 'owner'
             && request.resource.data.keys().hasOnly(['uid','email','role','joinedAt'])
             && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid)
            ||
            (request.resource.data.role == 'member'
             && request.resource.data.keys().hasOnly(['uid','email','role','inviteCode','joinedAt'])
             && request.resource.data.inviteCode is string
             && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode))
             && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.groupId == groupId
             && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.expiresAt > request.time)
          );
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid == userId && resource.data.role != 'owner';
      }
      match /{subcollection}/{documentId} {
        allow read, create, update, delete: if isMember(groupId)
          && subcollection in ['shopping','wishlist','settings'];
      }
    }
  }
}
